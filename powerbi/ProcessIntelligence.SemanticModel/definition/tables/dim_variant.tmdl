	partition dim_variant = m
		mode: import
		source =
				let
					Source = Csv.Document(
						File.Contents(DataFolder & "dim_variant.csv"),
						[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
					),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"variant_key", Int64.Type}, {"variant_path", type text}, {"variant_length", Int64.Type}, {"incident_count", Int64.Type}, {"variant_rank", Int64.Type}, {"is_happy_path", type logical}})
				in
					Typed

	annotation PBI_ResultType = Table
