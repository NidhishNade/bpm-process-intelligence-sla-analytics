					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"resolver_key", Int64.Type}, {"resolver_name", type text}})
				in
					Typed

	annotation PBI_ResultType = Table
