table dim_resolver
	lineageTag: e105dc52-ce5d-48ee-90df-18cb88ca333b

	column resolver_key
		dataType: int64
		isHidden
		lineageTag: 8f042613-1cb2-43e9-9864-7a4408a18332
		summarizeBy: none
		sourceColumn: resolver_key

	column Resolver
		dataType: string
		lineageTag: 3aa2022b-118b-4609-b343-559962cbc642
