	partition dim_contact_type = m
		mode: import
		source =
				let
					Source = Csv.Document(
						File.Contents(DataFolder & "dim_contact_type.csv"),
						[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
					),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"contact_type_key", Int64.Type}, {"contact_type_name", type text}, {"is_self_service", type logical}})
				in
					Typed

	annotation PBI_ResultType = Table
