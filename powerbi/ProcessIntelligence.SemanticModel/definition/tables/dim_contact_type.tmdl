table dim_contact_type
	lineageTag: 3048c14f-7327-473b-9b33-1c3e1529728c

	column contact_type_key
		dataType: int64
		isHidden
		lineageTag: 590f9982-3dd2-4179-a7e6-519e51fc5c90
		summarizeBy: none
